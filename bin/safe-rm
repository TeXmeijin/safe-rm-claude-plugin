#!/bin/bash

set -euo pipefail

# Default options
FORBIDDEN_DOTFILES=true
ONLY_GIT_NEW_FILE=false
FORBIDDEN_FILE_COUNT=10
FORBIDDEN_SPECIAL_DIRS=true
FORBIDDEN_OUTSIDE_CWD=true
FORBIDDEN_GITIGNORED=true
ENCODED_FILE_NAME=""
RECURSIVE=false
FORCE=false

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

show_help() {
    cat << EOF
safe-rm - Safe remove command for AI coding agents

USAGE:
    safe-rm [OPTIONS] <files...>

OPTIONS:
    --forbidden-dotfiles [true|false]    Forbid removal of dotfiles (default: true)
    --only-git-new-file [true|false]     Only allow removal of git new/unstaged files (default: false)
    --forbidden-file-count NUMBER        Max files allowed in directory removal (default: 10)
    --forbidden-special-dirs [true|false] Forbid removal of / and ~ (default: true)
    --forbidden-outside-cwd [true|false] Forbid removal of files outside current directory (default: true)
    --forbidden-gitignored [true|false]  Forbid removal of gitignored files (default: true)
    --encoded-file-name BASE64           Remove git-managed file with base64 encoded name
    -r, -R                              Remove directories recursively
    -h, --help                          Show this help message

EXAMPLES:
    # Basic usage with default protections
    safe-rm file.txt

    # Remove directory recursively
    safe-rm -r directory/

    # Allow dotfiles removal
    safe-rm --forbidden-dotfiles false .env

    # Only allow git new files
    safe-rm --only-git-new-file true newfile.txt

    # Remove git-managed file with confirmation
    safe-rm --encoded-file-name <base64_encoded_filename>

ALIAS SETUP:
    Add to ~/.zshrc or ~/.bashrc:
    alias rm='safe-rm'
EOF
}

# Parse command line arguments
parse_args() {
    local args=()

    while [[ $# -gt 0 ]]; do
        case $1 in
            --forbidden-dotfiles)
                if [[ "${2:-}" =~ ^(true|false)$ ]]; then
                    FORBIDDEN_DOTFILES="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --forbidden-dotfiles requires true or false${NC}" >&2
                    exit 1
                fi
                ;;
            --only-git-new-file)
                if [[ "${2:-}" =~ ^(true|false)$ ]]; then
                    ONLY_GIT_NEW_FILE="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --only-git-new-file requires true or false${NC}" >&2
                    exit 1
                fi
                ;;
            --forbidden-file-count)
                if [[ "${2:-}" =~ ^[0-9]+$ ]]; then
                    FORBIDDEN_FILE_COUNT="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --forbidden-file-count requires a number${NC}" >&2
                    exit 1
                fi
                ;;
            --forbidden-special-dirs)
                if [[ "${2:-}" =~ ^(true|false)$ ]]; then
                    FORBIDDEN_SPECIAL_DIRS="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --forbidden-special-dirs requires true or false${NC}" >&2
                    exit 1
                fi
                ;;
            --forbidden-outside-cwd)
                if [[ "${2:-}" =~ ^(true|false)$ ]]; then
                    FORBIDDEN_OUTSIDE_CWD="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --forbidden-outside-cwd requires true or false${NC}" >&2
                    exit 1
                fi
                ;;
            --forbidden-gitignored)
                if [[ "${2:-}" =~ ^(true|false)$ ]]; then
                    FORBIDDEN_GITIGNORED="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --forbidden-gitignored requires true or false${NC}" >&2
                    exit 1
                fi
                ;;
            --encoded-file-name)
                if [[ -n "${2:-}" ]]; then
                    ENCODED_FILE_NAME="$2"
                    shift 2
                else
                    echo -e "${RED}Error: --encoded-file-name requires a base64 string${NC}" >&2
                    exit 1
                fi
                ;;
            -h|--help)
                show_help
                exit 0
                ;;
            -r|-R)
                RECURSIVE=true
                shift
                ;;
            -f)
                FORCE=true
                shift
                ;;
            -rf|-fr)
                RECURSIVE=true
                FORCE=true
                shift
                ;;
            -*)
                echo -e "${RED}Error: Unknown option $1${NC}" >&2
                exit 1
                ;;
            *)
                args+=("$1")
                shift
                ;;
        esac
    done

    # Set positional parameters to remaining arguments
    if [[ ${#args[@]} -gt 0 ]]; then
        set -- "${args[@]}"
    else
        set --
    fi

    # Handle encoded file name case
    if [[ -n "$ENCODED_FILE_NAME" ]]; then
        local decoded_file
        decoded_file=$(echo "$ENCODED_FILE_NAME" | base64 -d 2>/dev/null) || {
            echo -e "${RED}Error: Invalid base64 encoding${NC}" >&2
            exit 1
        }

        if [[ ! -e "$decoded_file" ]]; then
            echo -e "${RED}Error: Decoded file does not exist: $decoded_file${NC}" >&2
            exit 1
        fi

        echo -e "${YELLOW}Removing git-managed file: $decoded_file${NC}" >&2
        /bin/rm -rf "$decoded_file"
        echo "Successfully removed: $decoded_file"
        exit 0
    fi

    # Check if any files provided
    if [[ $# -eq 0 ]]; then
        echo -e "${RED}Error: No files specified${NC}" >&2
        show_help
        exit 1
    fi

    # Store files to remove
    FILES=("$@")
}

# Check for forbidden special directories
check_special_dirs() {
    if [[ "$FORBIDDEN_SPECIAL_DIRS" == "true" ]]; then
        for file in "${FILES[@]}"; do
            local abs_path
            abs_path=$(realpath "$file" 2>/dev/null || echo "$file")

            if [[ "$abs_path" == "/" ]] || [[ "$abs_path" == "$HOME" ]]; then
                echo -e "${RED}FORBIDDEN: Cannot remove special directory: $abs_path${NC}"
                echo "You must manually run: rm $abs_path"
                exit 1
            fi
        done
    fi
}

# Check for dotfiles
check_dotfiles() {
    if [[ "$FORBIDDEN_DOTFILES" == "true" ]]; then
        for file in "${FILES[@]}"; do
            local filename
            filename=$(basename "$file")
            local abs_path
            abs_path=$(realpath "$file" 2>/dev/null || echo "$(pwd)/$file")

            if [[ "$filename" =~ ^\. ]]; then
                echo -e "${RED}FORBIDDEN: You are trying to remove dotfile: $filename${NC}"
                echo "You must ask your leader to run manually: rm $abs_path"
                exit 1
            fi
        done
    fi
}

# Check file count in directories
check_file_count() {
    for file in "${FILES[@]}"; do
        if [[ -d "$file" ]]; then
            local file_count
            file_count=$(find "$file" -type f | wc -l | tr -d ' ')

            if [[ "$file_count" -gt "$FORBIDDEN_FILE_COUNT" ]]; then
                local abs_path
                abs_path=$(realpath "$file" 2>/dev/null || echo "$(pwd)/$file")
                echo -e "${RED}FORBIDDEN: Directory contains $file_count files (limit: $FORBIDDEN_FILE_COUNT)${NC}"
                echo "Directory: $abs_path"
                echo "NEXT ACTION👉: You MUST ask your manager to run manually: rm -rf $abs_path"
                exit 1
            fi
        fi
    done
}

# Check git status
check_git_status() {
    if [[ "$ONLY_GIT_NEW_FILE" == "true" ]]; then
        # Check if we're in a git repository
        if ! git rev-parse --git-dir >/dev/null 2>&1; then
            echo -e "${RED}Error: Not in a git repository${NC}" >&2
            exit 1
        fi

        for file in "${FILES[@]}"; do
            if [[ -f "$file" ]]; then
                # Check if file is tracked by git
                if git ls-files --error-unmatch "$file" >/dev/null 2>&1; then
                    # File is git-managed
                    local abs_path
                    abs_path=$(realpath "$file" 2>/dev/null || echo "$(pwd)/$file")
                    local encoded_filename
                    encoded_filename=$(echo "$abs_path" | base64)

                    echo -e "${YELLOW}CONFIRMATION REQUIRED: File is git-managed: $file${NC}"
                    echo "Absolute path: $abs_path"
                    echo "To confirm removal, run:"
                    echo "safe-rm --encoded-file-name $encoded_filename"
                    exit 1
                fi
            elif [[ -d "$file" ]]; then
                # Check if directory contains git-managed files
                local git_files
                git_files=$(git ls-files "$file" 2>/dev/null | wc -l | tr -d ' ')

                if [[ "$git_files" -gt 0 ]]; then
                    local abs_path
                    abs_path=$(realpath "$file" 2>/dev/null || echo "$(pwd)/$file")
                    local encoded_filename
                    encoded_filename=$(echo "$abs_path" | base64)

                    echo -e "${YELLOW}CONFIRMATION REQUIRED: Directory contains $git_files git-managed files: $file${NC}"
                    echo "Absolute path: $abs_path"
                    echo "To confirm removal, run:"
                    echo "safe-rm --encoded-file-name $encoded_filename"
                    exit 1
                fi
            fi
        done
    fi
}

# Check if files are outside current working directory
check_outside_cwd() {
    if [[ "$FORBIDDEN_OUTSIDE_CWD" == "true" ]]; then
        local cwd
        cwd=$(pwd)

        for file in "${FILES[@]}"; do
            local abs_path
            abs_path=$(realpath "$file" 2>/dev/null || echo "$file")

            # Check if the file's absolute path starts with the current working directory
            if [[ "$abs_path" != "$cwd"/* ]] && [[ "$abs_path" != "$cwd" ]]; then
                echo -e "${RED}FORBIDDEN: Cannot remove files outside current directory${NC}" >&2
                echo "Current directory: $cwd" >&2
                echo "Target file: $abs_path" >&2
                echo "" >&2
                echo "You can override this restriction with --forbidden-outside-cwd false option," >&2
                echo "but you MUST confirm with your manager before using this option." >&2
                echo "" >&2
                echo "Example: safe-rm --forbidden-outside-cwd false $file" >&2
                exit 1
            fi
        done
    fi
}

# Check if force option is allowed (only for /tmp)
check_force_allowed() {
    if [[ "$FORCE" == "true" ]]; then
        for file in "${FILES[@]}"; do
            local abs_path
            abs_path=$(realpath "$file" 2>/dev/null || echo "$file")

            # Check if the file is under /tmp or /private/tmp (macOS)
            if [[ "$abs_path" != /tmp/* ]] && [[ "$abs_path" != /private/tmp/* ]]; then
                echo -e "${RED}FORBIDDEN: The -f (force) option is only allowed for files under /tmp${NC}" >&2
                echo "Target file: $abs_path" >&2
                echo "" >&2
                echo "Please use one of the following options:" >&2
                echo "  1. Use -r option only (without -f): safe-rm -r <directory>" >&2
                echo "  2. Ask your manager to run manually: rm -rf <directory>" >&2
                exit 1
            fi
        done
    fi
}

# Check if files are gitignored
check_gitignored() {
    if [[ "$FORBIDDEN_GITIGNORED" == "true" ]]; then
        # Check if we're in a git repository
        if ! git rev-parse --git-dir >/dev/null 2>&1; then
            # Not in a git repo, skip this check
            return 0
        fi

        for file in "${FILES[@]}"; do
            if [[ -e "$file" ]]; then
                # Check if file is gitignored
                if git check-ignore -q "$file" 2>/dev/null; then
                    local abs_path
                    abs_path=$(realpath "$file" 2>/dev/null || echo "$(pwd)/$file")

                    echo -e "${RED}FORBIDDEN: Cannot remove gitignored file: $file${NC}" >&2
                    echo "Absolute path: $abs_path" >&2
                    echo "" >&2
                    echo "This file is listed in .gitignore and may be important." >&2
                    echo "You can override this restriction with --forbidden-gitignored false option," >&2
                    echo "but you MUST confirm with your manager before using this option." >&2
                    echo "" >&2
                    echo "Example: safe-rm --forbidden-gitignored false $file" >&2
                    exit 1
                fi
            fi
        done
    fi
}

# Main function
main() {
    parse_args "$@"

    check_special_dirs
    check_force_allowed
    check_dotfiles
    check_outside_cwd
    check_gitignored
    check_file_count
    check_git_status

    # If all checks pass, perform the removal
    echo -e "${YELLOW}Removing files: ${FILES[*]}${NC}" >&2

    # Build rm command with appropriate flags
    local rm_opts=""
    if [[ "$RECURSIVE" == "true" ]]; then
        rm_opts="-r"
    fi
    if [[ "$FORCE" == "true" ]]; then
        rm_opts="${rm_opts}f"
    fi

    if [[ -n "$rm_opts" ]]; then
        /bin/rm "$rm_opts" "${FILES[@]}"
    else
        /bin/rm "${FILES[@]}"
    fi
    echo "Successfully removed: ${FILES[*]}"
}

# Run main function with all arguments
main "$@"
